# =============================================================================
# Root .env.example — values used by docker-compose.yml for local dev.
# Copy to .env at the repo root: `cp .env.example .env`
# Each service also has its own services/<name>/.env.example for running
# outside Docker (`pnpm dev` from within a service directory).
# =============================================================================

# ---- Postgres (single container, one logical database per service) --------
# POSTGRES_USER/PASSWORD are the container's bootstrap superuser, used ONLY
# by docker-postgres-init/init-databases.sh to create each service's own
# role + database on first container start. No service ever connects with
# these credentials — each service's DATABASE_URL (below) uses its own
# dedicated, database-scoped role, so one service's DB isolation is enforced
# by Postgres, not just by convention. See docker/postgres-init/init-databases.sh.
POSTGRES_USER=mms_root
POSTGRES_PASSWORD=mms_root_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Per-service DB roles (used to create each role + enforce isolation) --
VENDOR_MANAGEMENT_DB_PASSWORD=vendor_management_dev_password
PROCUREMENT_DB_PASSWORD=procurement_dev_password
INVENTORY_DB_PASSWORD=inventory_dev_password
RECEIVING_DB_PASSWORD=receiving_dev_password
WAREHOUSE_OPERATIONS_DB_PASSWORD=warehouse_operations_dev_password
RETAIL_SALES_DB_PASSWORD=retail_sales_dev_password
SALES_AUDIT_DB_PASSWORD=sales_audit_dev_password
FINANCIALS_DB_PASSWORD=financials_dev_password

# ---- RabbitMQ (event bus) ---------------------------------------------------
RABBITMQ_USER=mms
RABBITMQ_PASSWORD=mms_dev_password
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_EXCHANGE=mms.events

# ---- Feature flags (per phase — see README "Feature Flag Configuration") --
# Phase 1 — Foundation (on by default)
FEATURE_VENDOR_MANAGEMENT_ENABLED=true
FEATURE_PROCUREMENT_ENABLED=true
FEATURE_INVENTORY_ENABLED=true
# Phase 2 — Warehouse (off until built)
FEATURE_RECEIVING_ENABLED=false
FEATURE_WAREHOUSE_OPERATIONS_ENABLED=false
# Phase 3 — Retail (off until built)
FEATURE_RETAIL_SALES_ENABLED=false
FEATURE_SALES_AUDIT_ENABLED=false
# Phase 4 — Accounting (off until built)
FEATURE_FINANCIALS_ENABLED=false

# ---- Procurement approval workflow (D-1) -----------------------------------
PO_APPROVAL_THRESHOLD_KES=100000

# ---- Inventory dynamic reorder threshold (D-3) ------------------------------
# threshold = ceil(unitsPerDay * REORDER_LEAD_TIME_DAYS)
REORDER_LEAD_TIME_DAYS=7

# ---- Service ports (REST) ---------------------------------------------------
VENDOR_MANAGEMENT_PORT=3001
PROCUREMENT_PORT=3002
INVENTORY_PORT=3003
RECEIVING_PORT=3004
WAREHOUSE_OPERATIONS_PORT=3005
RETAIL_SALES_PORT=3006
SALES_AUDIT_PORT=3007
FINANCIALS_PORT=3008

# ---- Inventory gRPC port (Retail Sales -> Inventory stock check, NFR-5) ----
INVENTORY_GRPC_PORT=5003
INVENTORY_GRPC_URL=localhost:5003

# ---- Inter-service REST base URLs (Section 5 sync calls) -------------------
# Used by the calling service's own client wrapper, e.g. Procurement calling
# Vendor Management to price a PO (FR-2.x), or (once built) Receiving calling
# Procurement, Warehouse Ops calling Inventory, Sales Audit calling Retail Sales.
VENDOR_MANAGEMENT_URL=http://localhost:3001
PROCUREMENT_URL=http://localhost:3002
INVENTORY_URL=http://localhost:3003
RECEIVING_URL=http://localhost:3004
WAREHOUSE_OPERATIONS_URL=http://localhost:3005
RETAIL_SALES_URL=http://localhost:3006
SALES_AUDIT_URL=http://localhost:3007
FINANCIALS_URL=http://localhost:3008

# ---- Per-service DATABASE_URLs (each uses its own role + database only) ---
# Format: postgresql://<service_role>:<service_password>@<host>:<port>/<db>?schema=public
VENDOR_MANAGEMENT_DATABASE_URL=postgresql://vendor_management_svc:vendor_management_dev_password@localhost:5432/vendor_management?schema=public
PROCUREMENT_DATABASE_URL=postgresql://procurement_svc:procurement_dev_password@localhost:5432/procurement?schema=public
INVENTORY_DATABASE_URL=postgresql://inventory_svc:inventory_dev_password@localhost:5432/inventory?schema=public
RECEIVING_DATABASE_URL=postgresql://receiving_svc:receiving_dev_password@localhost:5432/receiving?schema=public
WAREHOUSE_OPERATIONS_DATABASE_URL=postgresql://warehouse_operations_svc:warehouse_operations_dev_password@localhost:5432/warehouse_operations?schema=public
RETAIL_SALES_DATABASE_URL=postgresql://retail_sales_svc:retail_sales_dev_password@localhost:5432/retail_sales?schema=public
SALES_AUDIT_DATABASE_URL=postgresql://sales_audit_svc:sales_audit_dev_password@localhost:5432/sales_audit?schema=public
FINANCIALS_DATABASE_URL=postgresql://financials_svc:financials_dev_password@localhost:5432/financials?schema=public

# ---- Frontend dev ports -----------------------------------------------------
VENDOR_MANAGEMENT_PORTAL_PORT=3101
PROCUREMENT_DASHBOARD_PORT=3102
INVENTORY_CONTROL_CENTER_PORT=3103
WAREHOUSE_RECEIVING_APP_PORT=3104
WAREHOUSE_FLOOR_APP_PORT=3105
POS_TERMINAL_APP_PORT=3106
STORE_MANAGER_DASHBOARD_PORT=3107
FINANCE_PORTAL_PORT=3108
