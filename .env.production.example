# =============================================================================
# Production .env for the VPS — copy to .env in the app directory (/opt/mms)
# ON THE VPS ONLY. Never commit the filled-in copy.
#   cp .env.production.example .env && chmod 600 .env
# Generate each secret with:  openssl rand -hex 24
#
# The DB passwords are applied by docker/postgres-init only on the FIRST start
# of an empty postgres volume — set them before the first deploy. Changing
# them later means ALTER ROLE ... PASSWORD inside postgres as well.
# =============================================================================

# ---- Postgres bootstrap superuser (only used by the init script) ----------
POSTGRES_USER=mms_root
POSTGRES_PASSWORD=CHANGE_ME

# ---- Per-service DB roles --------------------------------------------------
VENDOR_MANAGEMENT_DB_PASSWORD=CHANGE_ME
PROCUREMENT_DB_PASSWORD=CHANGE_ME
INVENTORY_DB_PASSWORD=CHANGE_ME
RECEIVING_DB_PASSWORD=CHANGE_ME
WAREHOUSE_OPERATIONS_DB_PASSWORD=CHANGE_ME
RETAIL_SALES_DB_PASSWORD=CHANGE_ME
SALES_AUDIT_DB_PASSWORD=CHANGE_ME
FINANCIALS_DB_PASSWORD=CHANGE_ME
DIRECTORY_DB_PASSWORD=CHANGE_ME

# ---- RabbitMQ ---------------------------------------------------------------
RABBITMQ_USER=mms
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_EXCHANGE=mms.events

# ---- Sign-in and permissions (D-16) -----------------------------------------
# Signs every session token. openssl rand -hex 32. Changing it signs everyone out.
AUTH_JWT_SECRET=CHANGE_ME
# Must match DOMAIN and HOST_PREFIX (deploy/hosts.sh). With a prefix, the
# allowlist names only this system's apps, not every site on the domain.
# The dashboard sits on the bare prefix name (mms.example.com), which the
# mms-* pattern doesn't match, so it is listed on its own:
#   no prefix:           CORS_ORIGINS=https://*.example.com
#   HOST_PREFIX=mms-:    CORS_ORIGINS=https://mms.example.com,https://mms-*.example.com
# The cookie must cover every app and API host, so it is always the parent
# domain. It is httpOnly and named mms_session, so other sites on the domain
# can't read it in the browser, but they are sent it.
CORS_ORIGINS=https://mms.reduzer.co.ke,https://mms-*.reduzer.co.ke
COOKIE_DOMAIN=.reduzer.co.ke
COOKIE_SECURE=true
SWAGGER_ENABLED=false
# The first owner. Sign in at any app as this id with this password, then
# choose a new one. Only used while no owner can sign in.
BOOTSTRAP_OWNER_ID=owner
BOOTSTRAP_OWNER_PASSWORD=CHANGE_ME
BOOTSTRAP_OWNER_NAME=Owner
# Leave empty in production: demo staff then can't sign in until an owner
# resets their passwords (or set DIRECTORY_SEED_DEMO=false below).
DEMO_STAFF_PASSWORD=

# ---- Feature flags ----------------------------------------------------------
FEATURE_VENDOR_MANAGEMENT_ENABLED=true
FEATURE_PROCUREMENT_ENABLED=true
FEATURE_INVENTORY_ENABLED=true
FEATURE_RECEIVING_ENABLED=true
FEATURE_WAREHOUSE_OPERATIONS_ENABLED=true
FEATURE_RETAIL_SALES_ENABLED=true
FEATURE_SALES_AUDIT_ENABLED=true
FEATURE_FINANCIALS_ENABLED=true
FEATURE_DIRECTORY_ENABLED=true
# Seeds demo stores/registers/staff on an empty directory DB. Set false for
# a real business.
DIRECTORY_SEED_DEMO=true

# ---- Business rules ---------------------------------------------------------
# Time zone for the sales report's hour-of-day grouping (D-20).
REPORT_TIMEZONE=Africa/Nairobi
PO_APPROVAL_THRESHOLD_KES=100000
REORDER_LEAD_TIME_DAYS=7
HIGH_VELOCITY_UNITS_PER_DAY=5
