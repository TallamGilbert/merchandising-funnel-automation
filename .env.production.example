# =============================================================================
# Production .env for the VPS — copy to .env in the app directory (/opt/mms)
# ON THE VPS ONLY. Never commit the filled-in copy.
#   cp .env.production.example .env && chmod 600 .env
# Generate each secret with:  openssl rand -hex 24
#
# The DB passwords are applied by docker/postgres-init only on the FIRST start
# of an empty postgres volume — set them before the first deploy. Changing
# them later means ALTER ROLE ... PASSWORD inside postgres as well.
# =============================================================================

# ---- Postgres bootstrap superuser (only used by the init script) ----------
POSTGRES_USER=mms_root
POSTGRES_PASSWORD=CHANGE_ME

# ---- Per-service DB roles --------------------------------------------------
VENDOR_MANAGEMENT_DB_PASSWORD=CHANGE_ME
PROCUREMENT_DB_PASSWORD=CHANGE_ME
INVENTORY_DB_PASSWORD=CHANGE_ME
RECEIVING_DB_PASSWORD=CHANGE_ME
WAREHOUSE_OPERATIONS_DB_PASSWORD=CHANGE_ME
RETAIL_SALES_DB_PASSWORD=CHANGE_ME
SALES_AUDIT_DB_PASSWORD=CHANGE_ME
FINANCIALS_DB_PASSWORD=CHANGE_ME
DIRECTORY_DB_PASSWORD=CHANGE_ME

# ---- RabbitMQ ---------------------------------------------------------------
RABBITMQ_USER=mms
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_EXCHANGE=mms.events

# ---- Feature flags ----------------------------------------------------------
FEATURE_VENDOR_MANAGEMENT_ENABLED=true
FEATURE_PROCUREMENT_ENABLED=true
FEATURE_INVENTORY_ENABLED=true
FEATURE_RECEIVING_ENABLED=true
FEATURE_WAREHOUSE_OPERATIONS_ENABLED=true
FEATURE_RETAIL_SALES_ENABLED=true
FEATURE_SALES_AUDIT_ENABLED=true
FEATURE_FINANCIALS_ENABLED=true
FEATURE_DIRECTORY_ENABLED=true
# Seeds demo stores/registers/staff on an empty directory DB. Set false for
# a real business.
DIRECTORY_SEED_DEMO=true

# ---- Business rules ---------------------------------------------------------
PO_APPROVAL_THRESHOLD_KES=100000
REORDER_LEAD_TIME_DAYS=7
HIGH_VELOCITY_UNITS_PER_DAY=5
