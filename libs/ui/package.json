{
  "name": "@mms/ui",
  "version": "0.1.0",
  "description": "Shared frontend building blocks: money/date formatting, alerts, modal, searchable pickers and Directory-backed staff/location/register pickers. Shipped as TypeScript source — each Next app compiles it via transpilePackages.",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jest": "^29.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.4"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts", "tsx"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", { "tsconfig": { "jsx": "react-jsx", "module": "commonjs", "esModuleInterop": true } }]
    },
    "testEnvironment": "node"
  }
}
