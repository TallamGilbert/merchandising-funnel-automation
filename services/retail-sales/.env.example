# Local (non-Docker) dev: copy to services/retail-sales/.env and adjust as needed.
# When running via `docker compose up`, the root .env is used instead.
NODE_ENV=development
PORT=3006
DATABASE_URL=postgresql://retail_sales_svc:retail_sales_dev_password@localhost:5432/retail_sales?schema=public

# FR-6.2 — gRPC client to Inventory's CheckAndReserveStock/ReleaseReservation.
INVENTORY_GRPC_URL=localhost:5003

RABBITMQ_USER=mms
RABBITMQ_PASSWORD=mms_dev_password
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_EXCHANGE=mms.events

FEATURE_VENDOR_MANAGEMENT_ENABLED=true
FEATURE_PROCUREMENT_ENABLED=true
FEATURE_INVENTORY_ENABLED=true
FEATURE_RECEIVING_ENABLED=true
FEATURE_WAREHOUSE_OPERATIONS_ENABLED=true
FEATURE_RETAIL_SALES_ENABLED=true
FEATURE_SALES_AUDIT_ENABLED=true
FEATURE_FINANCIALS_ENABLED=false
