generator client {
  provider = "prisma-client-js"
  // Custom output — pnpm dedups identical @prisma/client versions into one
  // physical store location, so without this every service's `prisma
  // generate` would overwrite the same shared client. This keeps each
  // service's generated client (and its schema-specific types) isolated.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentMethodType {
  CASH
  CARD
  GIFT_CARD
}

enum TransactionStatus {
  COMPLETED
  RETURNED
}

/// Retail pricing/promotions master data, owned entirely by Retail Sales
/// (FR-6.1). `sku` is the join key back to Inventory's own Product, but
/// never a foreign key into another service's database — Inventory's
/// unitCost (wholesale cost) is never read here, and this unitPrice is
/// never exposed to Inventory or Procurement.
model Product {
  id         String   @id @default(uuid())
  sku        String   @unique
  name       String
  unitPrice  Decimal  @db.Decimal(12, 2)
  taxRatePct Decimal  @default(0) @db.Decimal(5, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  promotions       Promotion[]
  transactionLines TransactionLine[]

  @@index([sku])
}

/// FR-6.1 — an active promotion/discount on one product. v1: a single
/// percentage-off with a validity window; no stacking or rules engine.
model Promotion {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  discountPct Decimal  @db.Decimal(5, 2)
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime @default(now())

  @@index([productId, startsAt, endsAt])
}

/// FR-6.3/6.5/6.6 — one completed sale. storeId/registerId/cashierId are
/// free-form identifiers (no auth/HR service exists in this brief).
/// Immutable once written; a return is a separate ReturnTransaction, never
/// an edit to this row (status flips to RETURNED once every line has been
/// fully returned).
model Transaction {
  id                String            @id @default(uuid())
  /// Human-readable sequence backing transactionNumber (e.g. TXN-1001).
  sequence          Int               @default(autoincrement())
  transactionNumber String            @unique
  storeId           String
  registerId        String
  cashierId         String
  status            TransactionStatus @default(COMPLETED)
  subtotalAmount    Decimal           @db.Decimal(12, 2)
  discountAmount    Decimal           @db.Decimal(12, 2)
  taxAmount         Decimal           @db.Decimal(12, 2)
  totalAmount       Decimal           @db.Decimal(12, 2)
  createdAt         DateTime          @default(now())

  lines   TransactionLine[]
  payments PaymentCapture[]
  returns  ReturnTransaction[]

  @@index([storeId, registerId, createdAt])
  @@index([cashierId])
}

/// One SKU line of a Transaction. `reservationId` ties back to the gRPC
/// CheckAndReserveStock call (FR-6.2) and rides straight onto ItemSoldEvent.
/// `quantityReturned` accumulates as ReturnLines are recorded against this
/// line, capping how much of it can still be returned.
model TransactionLine {
  id               String      @id @default(uuid())
  transactionId    String
  transaction      Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId        String
  product          Product     @relation(fields: [productId], references: [id])
  sku              String
  productName      String
  quantitySold     Int
  unitPrice        Decimal     @db.Decimal(12, 2)
  discountAmount   Decimal     @db.Decimal(12, 2)
  taxAmount        Decimal     @db.Decimal(12, 2)
  lineTotal        Decimal     @db.Decimal(12, 2)
  reservationId    String
  locationCode     String
  quantityReturned Int         @default(0)

  returnLines ReturnLine[]

  @@index([transactionId])
  @@index([sku])
}

/// FR-6.5 — one payment instrument on a sale; a split payment is more than
/// one row on the same Transaction.
model PaymentCapture {
  id            String            @id @default(uuid())
  transactionId String
  transaction   Transaction       @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  method        PaymentMethodType
  amount        Decimal           @db.Decimal(12, 2)

  @@index([transactionId])
}

/// FR-6.4 — a return/exchange against an earlier Transaction. Publishes
/// ItemReturned (D-8); no inspection step (D-5), so every returned unit
/// goes straight back to Available.
model ReturnTransaction {
  id                    String      @id @default(uuid())
  /// Human-readable sequence backing returnNumber (e.g. RET-1001).
  sequence              Int         @default(autoincrement())
  returnNumber          String      @unique
  originalTransactionId String
  originalTransaction   Transaction @relation(fields: [originalTransactionId], references: [id])
  storeId               String
  registerId            String
  refundAmount          Decimal     @db.Decimal(12, 2)
  createdAt             DateTime    @default(now())

  lines ReturnLine[]

  @@index([originalTransactionId])
}

model ReturnLine {
  id                  String            @id @default(uuid())
  returnTransactionId String
  returnTransaction   ReturnTransaction @relation(fields: [returnTransactionId], references: [id], onDelete: Cascade)
  transactionLineId   String
  transactionLine     TransactionLine   @relation(fields: [transactionLineId], references: [id])
  sku                 String
  productName         String
  quantityReturned    Int
  locationCode        String
  refundAmount        Decimal           @db.Decimal(12, 2)

  @@index([returnTransactionId])
  @@index([transactionLineId])
}
