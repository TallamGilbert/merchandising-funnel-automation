# Local (non-Docker) dev: copy to services/warehouse-operations/.env and adjust as needed.
# When running via `docker compose up`, the root .env is used instead.
NODE_ENV=development
PORT=3005
DATABASE_URL=postgresql://warehouse_operations_svc:warehouse_operations_dev_password@localhost:5432/warehouse_operations?schema=public

RABBITMQ_USER=mms
RABBITMQ_PASSWORD=mms_dev_password
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_EXCHANGE=mms.events

# Warehouse Ops calls Inventory (REST, sync) for item attributes/velocity (FR-4.7)
# and to confirm final bin locations (FR-5.7).
INVENTORY_URL=http://localhost:3003

# Items selling at least this many units/day are steered to bins nearest dispatch.
HIGH_VELOCITY_UNITS_PER_DAY=5

FEATURE_VENDOR_MANAGEMENT_ENABLED=true
FEATURE_PROCUREMENT_ENABLED=true
FEATURE_INVENTORY_ENABLED=true
FEATURE_RECEIVING_ENABLED=true
FEATURE_WAREHOUSE_OPERATIONS_ENABLED=true
FEATURE_RETAIL_SALES_ENABLED=false
FEATURE_SALES_AUDIT_ENABLED=false
FEATURE_FINANCIALS_ENABLED=false
