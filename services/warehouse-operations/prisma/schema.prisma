generator client {
  provider = "prisma-client-js"
  // Custom output — pnpm dedups identical @prisma/client versions into one
  // physical store location, so without this every service's `prisma
  // generate` would overwrite the same shared client. This keeps each
  // service's generated client (and its schema-specific types) isolated.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PutawayTaskStatus {
  PENDING
  COMPLETED
}

enum TransferStatus {
  PICKING
  COMPLETED
}

enum PickTaskStatus {
  PENDING
  PICKED
}

/// A physical bin/shelf (FR-5.1, FR-5.5). `locationCode` is a plain string
/// matching Inventory's location codes — never a foreign key (NFR-1).
/// `usedVolumeCm3` / `usedWeightKg` are capacity *reserved*: they go up when
/// a putaway task is directed at the bin (so two trucks can't be sent to the
/// same last free shelf) and come down when a pick removes stock or a task
/// is re-assigned elsewhere.
model Bin {
  id                String   @id @default(uuid())
  code              String   @unique
  locationCode      String
  zone              String
  /// Lower = closer to dispatch. Fast-moving items are steered to low numbers.
  pickPriority      Int      @default(100)
  capacityVolumeCm3 Decimal  @db.Decimal(14, 2)
  maxWeightKg       Decimal  @db.Decimal(10, 2)
  usedVolumeCm3     Decimal  @default(0) @db.Decimal(14, 2)
  usedWeightKg      Decimal  @default(0) @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  stock        BinStock[]
  putawayTasks PutawayTask[]
  picks        PickTask[]

  @@index([locationCode])
}

/// What is physically in a bin — needed to direct picking (FR-5.3). This is
/// geography, not the authoritative stock count; Inventory owns that.
model BinStock {
  id       String @id @default(uuid())
  binId    String
  bin      Bin    @relation(fields: [binId], references: [id], onDelete: Cascade)
  sku      String
  quantity Int    @default(0)
  /// Per-unit footprint captured at putaway, so a pick knows how much bin
  /// capacity it frees without calling Inventory again.
  unitVolumeCm3 Decimal @default(0) @db.Decimal(14, 2)
  unitWeightKg  Decimal @default(0) @db.Decimal(10, 2)

  @@unique([binId, sku])
  @@index([sku])
}

/// Created automatically from a GoodsReceived event (FR-5.6). One task per
/// (GRN, SKU); the unique constraint makes event redelivery idempotent.
/// `binId` is null while no bin could be chosen (nothing had room, or
/// Inventory's item attributes were unavailable) until a supervisor or a
/// retry assigns one.
model PutawayTask {
  id           String            @id @default(uuid())
  grnNumber    String
  poNumber     String
  sku          String
  productName  String
  quantity     Int
  locationCode String
  binId        String?
  bin          Bin?              @relation(fields: [binId], references: [id])
  /// Capacity reserved on `bin` for this task; released if the task is re-assigned.
  reservedVolumeCm3 Decimal        @default(0) @db.Decimal(14, 2)
  reservedWeightKg  Decimal        @default(0) @db.Decimal(10, 2)
  status       PutawayTaskStatus @default(PENDING)
  completedById String?
  completedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([grnNumber, sku])
  @@index([status])
  @@index([locationCode])
}

/// Warehouse -> showroom stock movement (FR-5.4).
model Transfer {
  id               String         @id @default(uuid())
  /// Human-readable sequence backing transferNumber generation (e.g. TRF-1001).
  sequence         Int            @default(autoincrement())
  transferNumber   String         @unique
  sku              String
  quantity         Int
  fromLocationCode String
  toLocationCode   String
  status           TransferStatus @default(PICKING)
  requestedById    String
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  picks PickTask[]

  @@index([status])
}

/// One bin-level instruction to a picker (FR-5.3).
model PickTask {
  id         String         @id @default(uuid())
  transferId String
  transfer   Transfer       @relation(fields: [transferId], references: [id], onDelete: Cascade)
  binId      String
  bin        Bin            @relation(fields: [binId], references: [id])
  sku        String
  quantity   Int
  status     PickTaskStatus @default(PENDING)
  pickedById String?
  pickedAt   DateTime?

  @@index([transferId])
  @@index([status])
}
