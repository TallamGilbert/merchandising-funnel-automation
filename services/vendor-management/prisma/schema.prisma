generator client {
  provider = "prisma-client-js"
  // Custom output — pnpm dedups identical @prisma/client versions into one
  // physical store location, so without this every service's `prisma
  // generate` would overwrite the same shared client. This keeps each
  // service's generated client (and its schema-specific types) isolated.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SupplierStatus {
  ACTIVE
  ARCHIVED
}

/// Authoritative supplier profile (FR-1.1). Owned exclusively by this
/// service — no other service may query this table directly (NFR-1).
model Supplier {
  id               String         @id @default(uuid())
  name             String
  contactName      String?
  email            String
  phone            String?
  address          String?
  /// Net payment terms in days (e.g. 30 = Net 30). Frozen onto a PO by
  /// Procurement at creation time (FR-2.2) — this is the live value.
  paymentTermsDays Int
  status           SupplierStatus @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  products        SupplierProduct[]
  deliveryRecords SupplierDeliveryRecord[]

  @@index([status])
}

/// Products a supplier is authorized to provide, and at what cost (FR-1.2).
/// `sku` is a cross-service product identifier — Inventory owns the product
/// master record; this table does not (and must not) hold Inventory's data.
model SupplierProduct {
  id          String   @id @default(uuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  sku         String
  productName String
  unitCost    Decimal  @db.Decimal(12, 2)
  currency    String   @default("KES")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([supplierId, sku])
  @@index([sku])
}

/// Historical on-time-delivery record per supplier (FR-1.4). `poReference`
/// is Procurement's PO number, kept as an opaque string — this service does
/// not hold a foreign key into Procurement's database (NFR-1).
model SupplierDeliveryRecord {
  id                 String   @id @default(uuid())
  supplierId         String
  supplier           Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  poReference        String
  expectedDate       DateTime @db.Date
  actualDeliveryDate DateTime @db.Date
  onTime             Boolean
  createdAt          DateTime @default(now())

  @@index([supplierId])
}
