# Local (non-Docker) dev: copy to services/inventory/.env and adjust as needed.
# When running via `docker compose up`, the root .env is used instead.
NODE_ENV=development
PORT=3003
DATABASE_URL=postgresql://inventory_svc:inventory_dev_password@localhost:5432/inventory?schema=public

RABBITMQ_USER=mms
RABBITMQ_PASSWORD=mms_dev_password
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_EXCHANGE=mms.events

# gRPC server port for the checkout stock-check RPC (FR-4.5, NFR-5).
INVENTORY_GRPC_PORT=5003

# Lead-time multiplier used to derive the dynamic StockLow threshold from
# sales velocity: threshold = ceil(unitsPerDay * REORDER_LEAD_TIME_DAYS) (D-3).
REORDER_LEAD_TIME_DAYS=7

FEATURE_VENDOR_MANAGEMENT_ENABLED=true
FEATURE_PROCUREMENT_ENABLED=true
FEATURE_INVENTORY_ENABLED=true
FEATURE_RECEIVING_ENABLED=true
FEATURE_WAREHOUSE_OPERATIONS_ENABLED=true
FEATURE_RETAIL_SALES_ENABLED=true
FEATURE_SALES_AUDIT_ENABLED=true
FEATURE_FINANCIALS_ENABLED=false
