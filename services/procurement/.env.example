# Local (non-Docker) dev: copy to services/procurement/.env and adjust as needed.
# When running via `docker compose up`, the root .env is used instead.
NODE_ENV=development
PORT=3002
DATABASE_URL=postgresql://procurement_svc:procurement_dev_password@localhost:5432/procurement?schema=public

RABBITMQ_USER=mms
RABBITMQ_PASSWORD=mms_dev_password
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_EXCHANGE=mms.events

# Procurement calls Vendor Management (REST, sync) to price a PO (FR-2.x).
VENDOR_MANAGEMENT_URL=http://localhost:3001

# Value-based PO approval threshold (D-1).
PO_APPROVAL_THRESHOLD_KES=100000

FEATURE_VENDOR_MANAGEMENT_ENABLED=true
FEATURE_PROCUREMENT_ENABLED=true
FEATURE_INVENTORY_ENABLED=true
FEATURE_RECEIVING_ENABLED=true
FEATURE_WAREHOUSE_OPERATIONS_ENABLED=true
FEATURE_RETAIL_SALES_ENABLED=false
FEATURE_SALES_AUDIT_ENABLED=false
FEATURE_FINANCIALS_ENABLED=false
