# Local (non-Docker) dev: copy to services/directory/.env and adjust as needed.
# When running via `docker compose up`, the root .env is used instead.
NODE_ENV=development
PORT=3009
DATABASE_URL=postgresql://directory_svc:directory_dev_password@localhost:5432/directory?schema=public

RABBITMQ_USER=mms
RABBITMQ_PASSWORD=mms_dev_password
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_EXCHANGE=mms.events

FEATURE_VENDOR_MANAGEMENT_ENABLED=true
FEATURE_PROCUREMENT_ENABLED=true
FEATURE_INVENTORY_ENABLED=true
FEATURE_RECEIVING_ENABLED=true
FEATURE_WAREHOUSE_OPERATIONS_ENABLED=true
FEATURE_RETAIL_SALES_ENABLED=true
FEATURE_SALES_AUDIT_ENABLED=true
FEATURE_FINANCIALS_ENABLED=true
FEATURE_DIRECTORY_ENABLED=true
# Seeds demo locations, registers and staff on first start when the directory is empty.
DIRECTORY_SEED_DEMO=true
