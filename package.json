{
  "name": "merchandising-funnel-automation",
  "private": true,
  "version": "0.1.0",
  "description": "Distributed Merchandise Management System (MMS) — capstone monorepo",
  "license": "MIT",
  "engines": {
    "node": ">=20.17.0 <21",
    "pnpm": ">=9"
  },
  "scripts": {
    "lint": "pnpm -r --if-present run lint",
    "build": "pnpm -r --if-present run build",
    "pretest": "pnpm --filter @mms/shared run build",
    "test": "pnpm -r --if-present run test",
    "pretest:e2e": "pnpm --filter @mms/shared run build",
    "test:e2e": "pnpm -r --if-present run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "proto:generate": "bash scripts/generate-proto.sh",
    "dev:services": "pnpm --parallel --filter @mms/vendor-management --filter @mms/procurement --filter @mms/inventory --filter @mms/receiving --filter @mms/warehouse-operations --filter @mms/retail-sales --filter @mms/sales-audit --filter @mms/directory run dev",
    "dev:frontends": "pnpm --parallel --filter @mms/vendor-management-portal --filter @mms/procurement-dashboard --filter @mms/inventory-control-center --filter @mms/warehouse-receiving-app --filter @mms/warehouse-floor-app --filter @mms/pos-terminal-app --filter @mms/store-manager-dashboard run dev",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.70.0"
  }
}
